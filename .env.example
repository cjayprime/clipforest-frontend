# ClipRover web environment. Copy to .env and adjust. Never commit real secrets.
#
# The browser only ever talks to this app's own origin: next.config.ts rewrites
# /api/* to the backend, so auth cookies stay first-party and there is no CORS.
# Nothing here is exposed to the browser (no NEXT_PUBLIC_* variables).

# Where the backend API lives, as seen from *this server* (not from the browser).
#   local development : http://localhost:4000
#   containers        : http://api:4000
#   split deployment  : https://api.your-domain.com
API_INTERNAL_URL=http://localhost:4000

# Port `next start` / `next dev` listens on.
PORT=3000
